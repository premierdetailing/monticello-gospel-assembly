{
 "cleanUrls": true,
 "trailingSlash": false,
 "rewrites": [
  {
   "source": "/studies",
   "destination": "/api/studies"
  },
  {
   "source": "/studies/:slug",
   "destination": "/api/studies?slug=:slug"
  }
 ],
 "functions": {
  "api/studies.js": {
   "includeFiles": "api/_tpl/**"
  }
 },
 "redirects": [
  {
   "source": "/index",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/give",
   "destination": "https://venmo.com/u/MGALENEXA",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    }
   ]
  },
  {
   "source": "/(img|fonts)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000"
    }
   ]
  },
  {
   "source": "/404",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  },
  {
   "source": "/(post|api/.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ]
}